# Public site (optional — used for canonical URLs / SEO)
VITE_SITE_URL=https://your-domain.example
VITE_FORMSPREE_CONTACT=

# Admin authentication (server-side only — do NOT prefix with VITE_)
# Used by Cloudflare Pages Functions (/api/admin/*) and Vite dev middleware.
# Set in Cloudflare Pages → Settings → Environment variables (Production + Preview).
# Never commit real passwords to Git.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-strong-admin-password
ADMIN_JWT_SECRET=your-long-random-jwt-secret-min-32-chars

# Optional second admin account (client) — server-side only, do NOT prefix with VITE_
CLIENT_ADMIN_EMAIL=
CLIENT_ADMIN_PASSWORD=

# Optional: Supabase Auth (when ready, set both to enable Supabase login)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
