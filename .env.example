# Public site (optional)
VITE_SITE_URL=https://ravezeto-demo.vercel.app
VITE_FORMSPREE_CONTACT=

# Admin authentication (server-side only — do NOT prefix with VITE_)
# Used by Vercel serverless functions (/api/admin/*) and Vite dev middleware.
# Set the same values in Vercel → Project → Settings → Environment Variables
# (Production, Preview, Development). Never commit real passwords to Git.
ADMIN_EMAIL=erikdev@ravezeto.hu
ADMIN_PASSWORD=your-strong-admin-password
ADMIN_JWT_SECRET=your-long-random-jwt-secret-min-32-chars

# Optional second admin account (client) — server-side only, do NOT prefix with VITE_
CLIENT_ADMIN_EMAIL=
CLIENT_ADMIN_PASSWORD=

# Optional: Supabase Auth (when ready, set both to enable Supabase login)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
