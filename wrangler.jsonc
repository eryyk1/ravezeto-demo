{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ravezeto",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // Must match Cloudflare dashboard binding name CMS_KV. Replace id with your KV namespace ID before `wrangler deploy`.
  "kv_namespaces": [{ "binding": "CMS_KV", "id": "7d9629259d8c4e8dae6ecc712fc61d73" }]
  // Optional later — not required for deploy (upload returns 503 until configured):
  // "r2_buckets": [{ "binding": "CMS_UPLOADS", "bucket_name": "ravezeto-cms-uploads" }]
}
