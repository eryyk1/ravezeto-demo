{
  "name": "ravezeto-react-test",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/generate-vercel-redirects.mjs && npx tsx scripts/generate-cms-snapshot.ts && vite build && node scripts/prerender-seo.mjs",
    "cms:snapshot": "npx tsx scripts/generate-cms-snapshot.ts",
    "redirects": "node scripts/generate-vercel-redirects.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "extract": "node scripts/extract-content.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "framer-motion": "^12.42.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3"
  },
  "devDependencies": {
    "wrangler": "^4.34.0",
    "tsx": "^4.20.5",
    "@types/node": "^26.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0"
  }
}
